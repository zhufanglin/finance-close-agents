# DeepSeek API（必填，用于 AI 差异解释 / 科目建议 / 发票抽取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 演示账号（默认 admin/admin123，运行 node prisma/seed.js 生成）
DEMO_USER=admin
DEMO_PASS=admin123
# 公网部署时可用环境变量覆盖 admin 初始密码（见 DEPLOY.md）
DEMO_ADMIN_PASSWORD=admin123

# OCR Python 解释器路径（本地开发默认用本机 venv；服务器/Docker 设 python3 或 python）
# OCR_PYTHON=python3
